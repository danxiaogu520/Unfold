{
  "$defs": {
    "ContentSnapshot": {
      "additionalProperties": false,
      "properties": {
        "revision_ref": {
          "pattern": "^[a-zA-Z0-9_.:-]{1,80}$",
          "title": "Revision Ref",
          "type": "string"
        },
        "text": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "revision_ref",
        "text"
      ],
      "title": "ContentSnapshot",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "evidence_keys": {
          "items": {
            "pattern": "^[a-zA-Z0-9_.:-]{1,80}$",
            "type": "string"
          },
          "title": "Evidence Keys",
          "type": "array"
        },
        "source": {
          "enum": [
            "user",
            "assumption",
            "unknown"
          ],
          "title": "Source",
          "type": "string"
        },
        "value": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "source",
        "evidence_keys"
      ],
      "title": "Fact",
      "type": "object"
    },
    "LearningProfileProposal": {
      "additionalProperties": false,
      "properties": {
        "background": {
          "$ref": "#/$defs/Fact"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "maxItems": 8,
          "title": "Constraints",
          "type": "array"
        },
        "excluded_scope": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "maxItems": 12,
          "title": "Excluded Scope",
          "type": "array"
        },
        "included_scope": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Included Scope",
          "type": "array"
        },
        "primary_purpose": {
          "$ref": "#/$defs/Fact"
        },
        "schema_version": {
          "const": "profile.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "secondary_purposes": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Secondary Purposes",
          "type": "array"
        },
        "target_abilities": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Target Abilities",
          "type": "array"
        },
        "topic": {
          "$ref": "#/$defs/Fact"
        }
      },
      "required": [
        "schema_version",
        "topic",
        "primary_purpose",
        "secondary_purposes",
        "background",
        "target_abilities",
        "included_scope",
        "excluded_scope",
        "constraints"
      ],
      "title": "LearningProfileProposal",
      "type": "object"
    },
    "ProfileSnapshot": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "$ref": "#/$defs/LearningProfileProposal"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "profile"
      ],
      "title": "ProfileSnapshot",
      "type": "object"
    },
    "ResourceRequest": {
      "additionalProperties": false,
      "properties": {
        "controls": {
          "items": {
            "enum": [
              "play",
              "pause",
              "step",
              "reset",
              "parameters",
              "run",
              "stop"
            ],
            "type": "string"
          },
          "title": "Controls",
          "type": "array"
        },
        "fallback_text": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Fallback Text",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-zA-Z0-9_.:-]{1,80}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "diagram",
            "playground",
            "interactive"
          ],
          "title": "Kind",
          "type": "string"
        },
        "purpose": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "runtime": {
          "anyOf": [
            {
              "const": "web",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Runtime"
        },
        "specification": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Specification",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "purpose",
        "specification",
        "runtime",
        "controls",
        "fallback_text"
      ],
      "title": "ResourceRequest",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "$ref": "#/$defs/ContentSnapshot"
    },
    "offered_candidate_refs": {
      "items": {
        "pattern": "^[a-zA-Z0-9_.:-]{1,80}$",
        "type": "string"
      },
      "title": "Offered Candidate Refs",
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/ProfileSnapshot"
    },
    "request": {
      "$ref": "#/$defs/ResourceRequest"
    },
    "schema_version": {
      "const": "resource-input.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "supported_kinds": {
      "items": {
        "enum": [
          "image",
          "diagram",
          "playground",
          "interactive"
        ],
        "type": "string"
      },
      "title": "Supported Kinds",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "content",
    "request",
    "supported_kinds",
    "offered_candidate_refs"
  ],
  "title": "ResourceInput",
  "type": "object"
}
