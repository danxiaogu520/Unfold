# 复制为 .env.local；通过 CLI --env-file 加载。不要填写聊天中或提交密钥。
DEEPSEEK_API_KEY=
UNFOLD_MODEL=deepseek-flash
UNFOLD_BASE_URL=https://api.deepseek.com
UNFOLD_CURRENCY=CNY
# 官方高峰价格作为保守预估，核对日期 2026-10-07；实际费用另记录余额差。
# 留空要求使用者先明确本轮上限。
UNFOLD_MAX_COST=
UNFOLD_INPUT_COST_PER_MILLION=2
UNFOLD_OUTPUT_COST_PER_MILLION=8
