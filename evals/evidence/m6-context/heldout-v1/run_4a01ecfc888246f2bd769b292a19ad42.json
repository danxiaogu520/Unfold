 \"type\": \"string\"}, \"resource_key\": {\"type\": \"string\"}, \"caption\": {\"type\": \"string\"}, \"fallback_text\": {\"type\": \"string\"}}, \"required\": [\"type\", \"resource_key\", \"caption\", \"fallback_text\"], \"type\": \"object\"}, \"ResourceRequest\": {\"additionalProperties\": false, \"properties\": {\"key\": {\"type\": \"string\"}, \"kind\": {\"enum\": [\"image\", \"diagram\", \"playground\", \"interactive\"], \"type\": \"string\"}, \"purpose\": {\"type\": \"string\"}, \"specification\": {\"type\": \"string\"}, \"runtime\": {\"anyOf\": [{\"type\": \"string\", \"enum\": [\"web\"]}, {\"type\": \"null\"}]}, \"controls\": {\"items\": {\"enum\": [\"play\", \"pause\", \"step\", \"reset\", \"parameters\", \"run\", \"stop\"], \"type\": \"string\"}, \"type\": \"array\"}, \"fallback_text\": {\"type\": \"string\"}}, \"required\": [\"key\", \"kind\", \"purpose\", \"specification\", \"runtime\", \"controls\", \"fallback_text\"], \"type\": \"object\"}}, \"additionalProperties\": false, \"properties\": {\"schema_version\": {\"type\": \"string\", \"enum\": [\"explanation.v1\"]}, \"target_key\": {\"type\": \"string\"}, \"overview\": {\"type\": \"string\"}, \"blocks\": {\"items\": {\"anyOf\": [{\"$ref\": \"#/$defs/MarkdownBlock\"}, {\"$ref\": \"#/$defs/DiagramBlock\"}, {\"$ref\": \"#/$defs/ResourceBlock\"}, {\"$ref\": \"#/$defs/ExerciseBlock\"}]}, \"type\": \"array\"}, \"resource_requests\": {\"items\": {\"$ref\": \"#/$defs/ResourceRequest\"}, \"type\": \"array\"}}, \"required\": [\"schema_version\", \"target_key\", \"overview\", \"blocks\", \"resource_requests\"], \"type\": \"object\"}",
