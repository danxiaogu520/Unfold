{
  "$defs": {
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "configuration",
            "invalid_input",
            "invalid_json",
            "schema_validation",
            "domain_validation",
            "refusal",
            "truncated",
            "content_filter",
            "schema_unsupported",
            "authentication",
            "rate_limit",
            "provider_error",
            "timeout",
            "outcome_unknown",
            "capability_limit",
            "budget_exceeded",
            "cancelled",
            "version_conflict"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "outcome_unknown": {
          "title": "Outcome Unknown",
          "type": "boolean"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_.:-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "schema_version": {
          "const": "error.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "code",
        "message",
        "retryable",
        "outcome_unknown",
        "run_id"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "LearningRunSnapshot": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiError"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_event_seq": {
          "minimum": 0,
          "title": "Last Event Seq",
          "type": "integer"
        },
        "operation": {
          "enum": [
            "questionnaire",
            "profile",
            "outline",
            "expansion",
            "reassessment",
            "explanation",
            "exercises",
            "resource"
          ],
          "title": "Operation",
          "type": "string"
        },
        "result_kind": {
          "anyOf": [
            {
              "enum": [
                "knowledge",
                "structure_preview",
                "exercise_set",
                "resource"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Kind"
        },
        "result_ref": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_.:-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Ref"
        },
        "run_id": {
          "pattern": "^[a-zA-Z0-9_.:-]{1,80}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "run.v3",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "conflicted"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "operation",
        "status",
        "attempt",
        "last_event_seq",
        "result_ref",
        "error",
        "result_kind"
      ],
      "title": "LearningRunSnapshot",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "queued",
        "started",
        "progress",
        "completed",
        "failed",
        "cancelled",
        "conflicted"
      ],
      "title": "Kind",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-zA-Z0-9_.:-]{1,80}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "event.v3",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "snapshot": {
      "$ref": "#/$defs/LearningRunSnapshot"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "kind",
    "snapshot"
  ],
  "title": "LearningRunEvent",
  "type": "object"
}
